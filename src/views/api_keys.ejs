/**
 * File: app/models/whatsapp_model.php
 * Model WhatsApp Gateway untuk arsitektur MVC Native Anda
 * Dipanggil di controller dengan: $this->model('whatsapp_model')->kirim_pesan($nomor, $pesan)
 */
class whatsapp_model {

    private $baseUrl = '<%= typeof currentOrigin !== 'undefined' ? currentOrigin : 'https://wa.septito.my.id' %>';
    private $apiKey  = '<%= keys.length > 0 ? keys[0].key : 'YOUR_API_KEY_HERE' %>';

    /**
     * 1. Kirim Pesan Teks WhatsApp
     * Otomatis fallback ke nomor WhatsApp cadangan jika nomor utama sibuk/offline.
     * Format nomor bebas: 08xx, 628xx, atau +628xx
     *
     * @param string $nomor Nomor tujuan
     * @param string $pesan Isi pesan WhatsApp
     * @return array Respon terurai dari server gateway
     */
    public function kirim_pesan($nomor, $pesan){
        $payload = [
            'key'     => $this->apiKey,
            'number'  => $nomor,
            'message' => $pesan
        ];
        return $this->request_api('/api/v1/send', $payload);
    }

    /**
     * 2. Cek apakah nomor terdaftar di WhatsApp
     * Disarankan mengecek nomor pelanggan/vendor sebelum pengiriman
     *
     * @param string $nomor Nomor telepon
     * @return array [status => bool, exists => bool, jid => string]
     */
    public function cek_nomor($nomor){
        $payload = [
            'key'    => $this->apiKey,
            'number' => $nomor
        ];
        return $this->request_api('/api/v1/check-number', $payload);
    }

    /**
     * 3. Ambil daftar semua device WhatsApp yang terhubung di server
     */
    public function get_devices(){
        return $this->request_api('/api/v1/devices', null, 'GET');
    }

    /**
     * Helper cURL Request Native (Tanpa Composer / Library Luar)
     */
    private function request_api($endpoint, $data = null, $method = 'POST'){
        $url = $this->baseUrl . $endpoint;
        $ch  = curl_init();

        $headers = [
            'Accept: application/json',
            'X-API-Key: ' . $this->apiKey
        ];

        $options = [
            CURLOPT_URL            => $url,
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_TIMEOUT        => 30,
            CURLOPT_SSL_VERIFYPEER => false, // Aman untuk localhost maupun server produksi
            CURLOPT_SSL_VERIFYHOST => false
        ];

        if (strtoupper($method) === 'POST') {
            $options[CURLOPT_POST] = true;
            $jsonData = json_encode($data ?? []);
            $options[CURLOPT_POSTFIELDS] = $jsonData;
            $headers[] = 'Content-Type: application/json';
            $headers[] = 'Content-Length: ' . strlen($jsonData);
        }

        $options[CURLOPT_HTTPHEADER] = $headers;
        curl_setopt_array($ch, $options);

        $response = curl_exec($ch);
        $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        $err      = curl_error($ch);
        curl_close($ch);

        if ($err) {
            return [
                'status'   => false,
                'httpCode' => 500,
                'message'  => 'cURL Connection Error: ' . $err
            ];
        }

        $result = json_decode($response, true);
        if (!is_array($result)) {
            return [
                'status'   => false,
                'httpCode' => $httpCode,
                'message'  => 'Invalid response dari server gateway',
                'raw'      => $response
            ];
        }

        $result['httpCode'] = $httpCode;
        return $result;
    }
}</pre>
