/**
 * File: app/controllers/belanja.php
 * Contoh integrasi notifikasi WhatsApp otomatis di controller belanja bahan Anda
 */
if (session_status() === PHP_SESSION_NONE) {
    session_start();
}

class belanja extends controller {

    // 1. Tampilan Utama Modul Belanja Bahan
    public function data(){
        $data['summary']   = $this->model('belanja_model')->get_summary();
        $data['belanja']   = $this->model('belanja_model')->get_belanja();
        $data['materials'] = $this->model('belanja_model')->get_item_options();
        $this->view('belanja/index', $data);
    }

    // 2. Live Search Tabel Belanja
    public function caribelanja(){
        $data['belanja'] = $this->model('belanja_model')->get_caribelanja();
        $this->view('belanja/table_belanja', $data);
    }

    // 3. CONTOH IMPLEMENTASI WA: Approval PO & Kirim Notifikasi ke Vendor
    public function approve_po($id_belanja){
        // A. Update status belanja di database
        $this->model('belanja_model')->update_status($id_belanja, 'po');

        // B. Ambil detail belanja & nomor WhatsApp vendor
        $po = $this->model('belanja_model')->get_detail_po($id_belanja);
        $no_wa_vendor = $po['no_hp_vendor']; // contoh: 081234567890 atau 6281234567890
        $nama_vendor  = $po['nama_vendor'];
        $no_po        = $po['no_po'];
        $total        = number_format($po['total_nominal'], 0, ',', '.');

        // C. Susun Pesan WhatsApp (*tebal*, _miring_, baris baru \n)
        $pesan = "Halo *{$nama_vendor}*,\n\n"
               . "Pengajuan Purchase Order *#{$no_po}* telah disetujui (*APPROVED*).\n"
               . "Total Nilai: *Rp {$total}*\n\n"
               . "Mohon segera diproses dan dikirimkan ke gudang kami. Terima kasih! 🙏";

        // D. Kirim WhatsApp menggunakan whatsapp_model (dengan Auto-Fallback multi-device!)
        $kirim_wa = $this->model('whatsapp_model')->kirim_pesan($no_wa_vendor, $pesan);

        // E. Return respon JSON ke modal frontend
        echo json_encode([
            'status'  => true,
            'message' => 'PO berhasil di-ACC dan WhatsApp telah dikirim ke Vendor!',
            'wa_res'  => $kirim_wa
        ]);
    }

    // 4. CONTOH IMPLEMENTASI WA: Notifikasi Barang Masuk ke Owner / Manajer
    public function terima_barang($id_belanja){
        $this->model('belanja_model')->update_status($id_belanja, 'barang_masuk');

        $no_owner = '081234567890'; // Nomor WhatsApp Owner / Bagian Purchasing
        $pesan = "📦 *Barang Masuk!*\n\nBarang dari PO *#{$id_belanja}* telah sampai dan diterima di gudang.";
        $this->model('whatsapp_model')->kirim_pesan($no_owner, $pesan);

        echo json_encode(['status' => true, 'message' => 'Status barang masuk berhasil disimpan!']);
    }
}</pre>
