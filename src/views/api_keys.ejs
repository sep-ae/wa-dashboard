<%- include('partials/header') %>

<div class="space-y-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">API Key Management</h1>
            <p class="text-slate-500 mt-1">Generate and manage secret keys used to authenticate external message dispatch requests.</p>
        </div>
        <div class="flex items-center space-x-3">
            <button onclick="openCreateKeyModal()" class="inline-flex items-center px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm shadow-md shadow-indigo-200 transition-all hover:scale-[1.02]">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Generate API Key
            </button>
        </div>
    </div>

    <!-- API Keys Table Card -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-xs overflow-hidden">
        <div class="p-5 border-b border-slate-100 flex items-center justify-between">
            <h3 class="font-bold text-slate-800 text-base">Active API Keys</h3>
            <span class="text-xs text-slate-400 font-medium"><%= keys.length %> Keys Registered</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/80 border-b border-slate-100 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                        <th class="py-3.5 px-6">Name</th>
                        <th class="py-3.5 px-6">API Key Token</th>
                        <th class="py-3.5 px-6">Status</th>
                        <th class="py-3.5 px-6">Created</th>
                        <th class="py-3.5 px-6 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-xs text-slate-700">
                    <% if (keys.length === 0) { %>
                    <tr>
                        <td colspan="5" class="py-10 text-center text-slate-400">
                            No API Keys found. Click "Generate API Key" to create your first token.
                        </td>
                    </tr>
                    <% } %>

                    <% keys.forEach(key => { %>
                    <tr class="hover:bg-slate-50/60 transition-colors">
                        <td class="py-4 px-6 font-bold text-slate-800">
                            <%= key.name %>
                        </td>
                        <td class="py-4 px-6">
                            <div class="inline-flex items-center space-x-2 bg-slate-100 px-3 py-1.5 rounded-xl border border-slate-200 font-mono text-[11px] text-slate-700">
                                <span><%= key.key %></span>
                                <button onclick="copyToClipboard('<%= key.key %>')" class="text-indigo-600 hover:text-indigo-800 ml-1" title="Copy to clipboard">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path></svg>
                                </button>
                            </div>
                        </td>
                        <td class="py-4 px-6">
                            <% if (key.is_active) { %>
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-800">
                                    Active
                                </span>
                            <% } else { %>
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-slate-100 text-slate-500">
                                    Disabled
                                </span>
                            <% } %>
                        </td>
                        <td class="py-4 px-6 text-slate-400 font-mono text-[11px]">
                            <%= new Date(key.created_at).toLocaleDateString() %>
                        </td>
                        <td class="py-4 px-6 text-right space-x-2">
                            <button onclick="toggleKey('<%= key.id %>')" class="text-slate-600 hover:text-indigo-600 font-semibold text-xs">
                                <%= key.is_active ? 'Disable' : 'Enable' %>
                            </button>
                            <button onclick="deleteKey('<%= key.id %>')" class="text-rose-500 hover:text-rose-700 font-semibold text-xs ml-3">
                                Delete
                            </button>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Developer Documentation & Postman Guide -->
    <div class="bg-white rounded-3xl border border-slate-200/90 shadow-sm p-6 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-4">
            <div>
                <h3 class="text-lg font-bold text-slate-900 flex items-center">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 mr-2.5"></span>
                    API & Postman Integration Guide
                </h3>
                <p class="text-xs text-slate-500 mt-0.5">Semua endpoint siap pakai di Postman. Cukup copy cURL di bawah dan paste ke fitur <strong>Import</strong> di Postman.</p>
            </div>
            <div class="inline-flex items-center text-xs font-semibold px-3 py-1.5 rounded-xl bg-indigo-50 text-indigo-700 border border-indigo-100">
                <span>Awalan Bebas: 08..., +62..., 628...</span>
            </div>
        </div>

        <!-- Documentation Tabs -->
        <div class="space-y-4">
            <div class="flex items-center space-x-2 border-b border-slate-100 pb-2 overflow-x-auto">
                <button onclick="switchDocTab('send')" id="tab-btn-send" class="px-4 py-2 rounded-xl text-xs font-bold transition-all bg-indigo-600 text-white shadow-xs whitespace-nowrap">
                    1. Kirim Pesan (/api/v1/send)
                </button>
                <button onclick="switchDocTab('check')" id="tab-btn-check" class="px-4 py-2 rounded-xl text-xs font-bold transition-all text-slate-600 hover:text-slate-900 hover:bg-slate-100 whitespace-nowrap">
                    2. Cek Nomor WA (/api/v1/check-number)
                </button>
                <button onclick="switchDocTab('devices')" id="tab-btn-devices" class="px-4 py-2 rounded-xl text-xs font-bold transition-all text-slate-600 hover:text-slate-900 hover:bg-slate-100 whitespace-nowrap">
                    3. List Device (/api/v1/devices)
                </button>
                <button onclick="switchDocTab('php')" id="tab-btn-php" class="px-4 py-2 rounded-xl text-xs font-bold transition-all text-slate-600 hover:text-slate-900 hover:bg-slate-100 whitespace-nowrap flex items-center space-x-1.5">
                    <span class="px-1.5 py-0.5 rounded bg-indigo-100 text-indigo-700 text-[10px] font-black font-mono">PHP</span>
                    <span>4. Contoh PHP Native (Model & Controller)</span>
                </button>
            </div>

            <!-- Tab 1: Send Message -->
            <div id="doc-tab-send" class="space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div class="flex items-center space-x-2">
                        <span class="px-2.5 py-1 rounded-lg bg-emerald-100 text-emerald-800 text-[11px] font-black font-mono">POST</span>
                        <code class="text-xs font-bold text-slate-800"><%= typeof currentOrigin !== 'undefined' ? currentOrigin : 'http://localhost:3000' %>/api/v1/send</code>
                    </div>
                    <div class="flex items-center space-x-2">
                        <button onclick="copySnippet('curl-send')" class="inline-flex items-center px-3 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition-all active:scale-95 shadow-xs">
                            <svg class="w-3.5 h-3.5 mr-1.5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path></svg>
                            Copy cURL (Import ke Postman)
                        </button>
                        <button onclick="copySnippet('json-send')" class="inline-flex items-center px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition-all active:scale-95">
