                        <pre id="code-php-model" class="leading-relaxed">&lt;?php
/**
 * WhatsApp Gateway Model
 * Menangani koneksi HTTP cURL Native ke server WhatsApp Gateway.
 * Kompatibel dengan PHP 7.4 - 8.3+ (Tanpa dependensi Composer / Guzzle).
 */
class WhatsAppGateway
{
    private string $baseUrl;
    private string $apiKey;

    /**
     * Inisialisasi Gateway dengan Base URL dan API Key
     */
    public function __construct(
        string $baseUrl = '<%= typeof currentOrigin !== 'undefined' ? currentOrigin : 'https://wa.septito.my.id' %>',
        string $apiKey = '<%= keys.length > 0 ? keys[0].key : 'YOUR_API_KEY_HERE' %>'
    ) {
        $this->baseUrl = rtrim($baseUrl, '/');
        $this->apiKey = $apiKey;
    }

    /**
     * Kirim pesan teks WhatsApp
     * Gateway otomatis melakukan fallback ke nomor WhatsApp cadangan jika nomor utama sibuk/offline.
     *
     * @param string $number  Nomor tujuan (format bebas: 08xx, 628xx, +628xx)
     * @param string $message Isi pesan WhatsApp
     * @return array Respon terurai dari server gateway
     */
    public function sendMessage(string $number, string $message): array
    {
        return $this->request('POST', '/api/v1/send', [
            'key'     => $this->apiKey,
            'number'  => $number,
            'message' => $message
        ]);
    }

    /**
     * Cek apakah nomor tujuan terdaftar dan aktif di WhatsApp
     * Sangat disarankan untuk memvalidasi nomor sebelum mengirim pesan promosi/OTP.
     *
     * @param string $number Nomor tujuan
     * @return array [status => bool, exists => bool, jid => string]
     */
    public function checkNumber(string $number): array
    {
        return $this->request('POST', '/api/v1/check-number', [
            'key'    => $this->apiKey,
            'number' => $number
        ]);
    }

    /**
     * Ambil daftar seluruh nomor / device WhatsApp yang terhubung di gateway
     *
     * @return array
     */
    public function getDevices(): array
    {
        return $this->request('GET', '/api/v1/devices');
    }

    /**
     * Helper cURL Request Native
     */
    private function request(string $method, string $endpoint, ?array $body = null): array
    {
        $url = $this->baseUrl . $endpoint;
        $ch = curl_init();

        $headers = [
            'Accept: application/json',
            'X-API-Key: ' . $this->apiKey
        ];

        $curlOptions = [
            CURLOPT_URL            => $url,
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_TIMEOUT        => 30,
            CURLOPT_SSL_VERIFYPEER => true
        ];

        if (strtoupper($method) === 'POST') {
            $curlOptions[CURLOPT_POST] = true;
            if ($body !== null) {
                $jsonData = json_encode($body);
                $curlOptions[CURLOPT_POSTFIELDS] = $jsonData;
                $headers[] = 'Content-Type: application/json';
                $headers[] = 'Content-Length: ' . strlen($jsonData);
            }
        }

        $curlOptions[CURLOPT_HTTPHEADER] = $headers;
        curl_setopt_array($ch, $curlOptions);

        $rawResponse = curl_exec($ch);
        $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        $curlError = curl_error($ch);
        curl_close($ch);

        if ($curlError) {
            return [
                'status'   => false,
                'httpCode' => 500,
                'message'  => 'cURL Connection Error: ' . $curlError
            ];
        }

        $response = json_decode($rawResponse, true);
        if (!is_array($response)) {
            return [
                'status'   => false,
                'httpCode' => $httpCode,
                'message'  => 'Invalid JSON response dari server gateway',
                'raw'      => $rawResponse
            ];
        }

        $response['httpCode'] = $httpCode;
        return $response;
    }
}</pre>
