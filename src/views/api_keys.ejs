/**
 * File: app/controllers/notifikasi.php
 * Controller khusus untuk endpoint pengiriman WhatsApp (via Form / AJAX)
 */
if (session_status() === PHP_SESSION_NONE) {
    session_start();
}

class notifikasi extends controller {

    // 1. Endpoint kirim pesan WhatsApp via POST / AJAX
    public function kirim(){
        header('Content-Type: application/json');

        // Tangkap input dari form POST atau payload JSON
        $nomor = $_POST['no_hp'] ?? '';
        $pesan = $_POST['pesan'] ?? '';

        if (empty($nomor) || empty($pesan)) {
            echo json_encode([
                'status'  => false,
                'message' => 'Nomor HP dan pesan WhatsApp wajib diisi!'
            ]);
            return;
        }

        // Panggil whatsapp_model via $this->model(...) bawaan MVC Anda
        $kirim = $this->model('whatsapp_model')->kirim_pesan($nomor, $pesan);
        echo json_encode($kirim);
    }

    // 2. Endpoint cek apakah nomor terdaftar di WA
    public function cek(){
        header('Content-Type: application/json');
        $nomor = $_POST['no_hp'] ?? '';

        if (empty($nomor)) {
            echo json_encode(['status' => false, 'message' => 'Nomor HP wajib diisi!']);
            return;
        }

        $cek = $this->model('whatsapp_model')->cek_nomor($nomor);
        echo json_encode($cek);
    }
}</pre>
