                    </div>
                </div>

                <!-- Code Block -->
                <div class="bg-slate-900 rounded-2xl p-4 text-xs font-mono text-slate-200 overflow-x-auto border border-slate-800 relative group">
                    <pre id="curl-check" class="leading-relaxed">curl -X POST <%= typeof currentOrigin !== 'undefined' ? currentOrigin : 'http://localhost:3000' %>/api/v1/check-number \
