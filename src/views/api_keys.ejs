  "key": "<%= keys.length > 0 ? keys[0].key : 'YOUR_API_KEY_HERE' %>",
  "number": "081234567890",
  "message": "Halo! Pesan ini dikirim otomatis via WhatsApp Gateway API."
}</textarea>

                <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-600">
