require_once __DIR__ . '/../models/WhatsAppGateway.php';

/**
 * NotificationController
 * Mengatur alur logika validasi dan pengiriman notifikasi WhatsApp
 */
class NotificationController
{
    private WhatsAppGateway $waGateway;

    public function __construct()
    {
        // Inisialisasi Model WhatsAppGateway
        $this->waGateway = new WhatsAppGateway();
    }

    /**
     * Contoh Aksi 1: Kirim Konfirmasi Pesanan / Invoice Pelanggan
     */
    public function sendInvoiceNotification(): void
    {
        header('Content-Type: application/json; charset=utf-8');

        // 1. Ambil input dari JSON payload (AJAX/Fetch) atau $_POST biasa
        $rawInput = file_get_contents('php://input');
        $input = json_decode($rawInput, true) ?: $_POST;

        $phone        = trim($input['phone'] ?? '');
        $customerName = trim($input['customer_name'] ?? 'Pelanggan');
        $invoiceNo    = trim($input['invoice_no'] ?? 'INV-' . date('YmdHis'));
        $totalAmount  = trim($input['total_amount'] ?? 'Rp 150.000');

        // 2. Validasi kelengkapan nomor tujuan
        if (empty($phone)) {
            http_response_code(400);
            echo json_encode([
                'success' => false,
                'message' => 'Nomor WhatsApp penerima wajib diisi!'
            ]);
            return;
        }

        // 3. Validasi real-time: cek apakah nomor terdaftar di WhatsApp
        $check = $this->waGateway->checkNumber($phone);
        if (empty($check['exists'])) {
            http_response_code(400);
            echo json_encode([
                'success' => false,
                'message' => 'Nomor ' . $phone . ' tidak terdaftar di WhatsApp!'
            ]);
            return;
        }

        // 4. Susun pesan dengan format WhatsApp (*tebal*, _miring_, baris baru \n)
        $message = "Halo *{$customerName}*,\n\n"
                 . "Pesanan Anda dengan nomor tagihan *#{$invoiceNo}* telah kami terima.\n"
                 . "Total Pembayaran: *{$totalAmount}*\n\n"
                 . "Pesanan Anda akan segera diproses dan dikirimkan.\n"
                 . "Terima kasih atas kepercayaannya! 🙏";

        // 5. Eksekusi pengiriman via Model (Gateway server otomatis fallback jika ada device offline)
        $result = $this->waGateway->sendMessage($phone, $message);

        // 6. Kembalikan JSON response ke client
        if (!empty($result['status']) && $result['status'] === true) {
            http_response_code(200);
            echo json_encode([
                'success'      => true,
                'message'      => 'Notifikasi WhatsApp berhasil dikirim!',
                'senderNumber' => $result['senderNumber'] ?? null,
                'deviceId'     => $result['deviceId'] ?? null,
                'deviceName'   => $result['deviceName'] ?? null
            ]);
        } else {
            http_response_code($result['httpCode'] ?? 500);
            echo json_encode([
                'success' => false,
                'message' => $result['message'] ?? 'Gagal mengirim pesan WhatsApp.',
                'error'   => $result
            ]);
        }
    }

    /**
     * Contoh Aksi 2: Kirim Kode OTP Verifikasi
     *
     * @param string $phone
     * @param string $otpCode
     * @return array
     */
    public function sendOtp(string $phone, string $otpCode): array
    {
        $message = "Kode OTP verifikasi akun Anda adalah: *{$otpCode}*.\n\n"
                 . "Jangan berikan kode ini kepada siapapun demi keamanan akun Anda. Berlaku 5 menit.";

        return $this->waGateway->sendMessage($phone, $message);
    }
}</pre>
